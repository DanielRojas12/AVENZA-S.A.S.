# Copie este archivo como .env y reemplace los valores.
# Cadena de conexión de Neon (Dashboard de Neon > Connect > Connection string)
DATABASE_URL=postgresql://USUARIO:CLAVE@ep-xxxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

PORT=4000
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173

# Opcional: componente de IA con Google Gemini (https://aistudio.google.com/apikey)
# Si se deja vacío, el recomendador usa el motor local de similitud.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
